{
  "name": "LightFlux",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "workspace",
  "runServices": [
    "workspace",
    "postgres"
  ],
  "workspaceFolder": "/workspaces/LightFlux",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    8081,
    8787,
    5432
  ],
  "portsAttributes": {
    "8081": {
      "label": "Expo Web"
    },
    "8787": {
      "label": "LightFlux API"
    },
    "5432": {
      "label": "PostgreSQL"
    }
  }
}
