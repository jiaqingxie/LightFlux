{
  "name": "LightFlux",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "workspace",
  "runServices": [
    "workspace"
  ],
  "workspaceFolder": "/workspaces/LightFlux",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "Expo Web"
    }
  }
}
